{
  "headers": [
    {
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ],
      "source": "**/*.@(eot|otf|ttf|ttc|woff|woff2|font.css)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ],
      "source": "**/*.@(js|css)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ],
      "source": "**/*.@(jpg|jpeg|gif|png|webp)"
    }
  ],
  "hosting": {
    "ignore": [
      "firebase.json",
      "jest.config.ts",
      "**/.*",
      "**/test/**",
      "**/.vscode/**",
      "**/node_modules/**"
    ],
    "public": "dist",
    "rewrites": [
      {
        "destination": "/index.html",
        "source": "**"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
